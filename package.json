{
  "name": "lighthouse",
  "displayName": "Lighthouse: Local Code Review",
  "description": "Local-only code review with reviews, threads, and Copilot-ready comment schema.",
  "version": "2026.1023.4",
  "publisher": "TimothyMothra",
  "private": true,
  "license": "MIT",
  "icon": "media/lighthouse.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/TimothyMothra/Lighthouse-LocalCodeReview.git"
  },
  "homepage": "https://github.com/TimothyMothra/Lighthouse-LocalCodeReview#readme",
  "bugs": {
    "url": "https://github.com/TimothyMothra/Lighthouse-LocalCodeReview/issues"
  },
  "keywords": [
    "code review",
    "git",
    "local review",
    "copilot"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:lighthouse.conversationPage",
    "workspaceContains:.vscode/lighthouse-reviews/**/comments.json"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Lighthouse runs Git and optional Copilot CLI commands and writes local review files. A trusted workspace is required."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Lighthouse requires a disk-backed Git working tree. Virtual workspaces are not supported."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lighthouse",
          "title": "Lighthouse: Local Code Review (2026.1023.4)",
          "icon": "media/lighthouse.svg"
        }
      ]
    },
    "views": {
      "lighthouse": [
        {
          "id": "lighthouse.comparison",
          "name": "Comparison",
          "type": "webview",
          "visibility": "collapsed",
          "icon": "media/lighthouse.svg",
          "initialSize": 450
        },
        {
          "id": "lighthouse.files",
          "name": "Changed Files",
          "type": "webview",
          "icon": "media/lighthouse.svg",
          "initialSize": 400
        },
        {
          "id": "lighthouse.conversations",
          "name": "Threads",
          "type": "webview",
          "icon": "media/lighthouse.svg",
          "initialSize": 200
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lighthouse.files",
        "contents": "No changed files between base and compare."
      },
      {
        "view": "lighthouse.conversations",
        "contents": "No threads yet. Start a review-wide thread or add a comment to a changed file."
      }
    ],
    "commands": [
      {
        "command": "lighthouse.configureCopilotMcp",
        "title": "Lighthouse: Configure Copilot CLI MCP"
      },
      {
        "command": "lighthouse.newConversation",
        "title": "Lighthouse: New Thread",
        "icon": "$(add)"
      },
      {
        "command": "lighthouse.viewConversation",
        "title": "Lighthouse: Read Thread"
      },
      {
        "command": "lighthouse.exportStartupDiagnostics",
        "title": "Lighthouse: Export Startup Diagnostics"
      },
      {
        "command": "lighthouse.refresh",
        "title": "Lighthouse: Refresh Local Reviews",
        "icon": "$(refresh)"
      },
      {
        "command": "lighthouse.createOrReply",
        "title": "Lighthouse: Add Comment / Reply",
        "icon": "$(comment)"
      },
      {
        "command": "lighthouse.toggleThreadResolved",
        "title": "Lighthouse: Toggle Resolved",
        "icon": "$(check)"
      },
      {
        "command": "lighthouse.resolveThread",
        "title": "Lighthouse: Resolve Thread",
        "icon": "$(check)"
      },
      {
        "command": "lighthouse.unresolveThread",
        "title": "Lighthouse: Reopen Thread",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "lighthouse.resolveThreadNode",
        "title": "Lighthouse: Resolve Thread",
        "icon": "$(check)"
      },
      {
        "command": "lighthouse.unresolveThreadNode",
        "title": "Lighthouse: Reopen Thread",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "lighthouse.askCopilotThread",
        "title": "Lighthouse: Ask Copilot to Review Thread",
        "icon": "$(hubot)"
      },
      {
        "command": "lighthouse.askCopilotReview",
        "title": "Lighthouse: Ask Copilot to Review (All Threads)",
        "icon": "$(hubot)"
      },
      {
        "command": "lighthouse.copyCommitId",
        "title": "Lighthouse: Copy Commit Id"
      },
      {
        "command": "lighthouse.copyBranchName",
        "title": "Lighthouse: Copy Branch Name"
      },
      {
        "command": "lighthouse.copyDirPath",
        "title": "Lighthouse: Copy Review Directory Path"
      },
      {
        "command": "lighthouse.pickBranches",
        "title": "Lighthouse: Pick Source/Target Branches",
        "icon": "$(git-branch)"
      },
      {
        "command": "lighthouse.switchReview",
        "title": "Lighthouse: Switch Active Review",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "lighthouse.openDirectory",
        "title": "Lighthouse: Open Branch Directory",
        "icon": "$(folder-opened)"
      },
      {
        "command": "lighthouse.gitPull",
        "title": "Lighthouse: Git Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "lighthouse.gitPush",
        "title": "Lighthouse: Git Push",
        "icon": "$(arrow-up)"
      },
      {
        "command": "lighthouse.openTerminalHere",
        "title": "Lighthouse: Open Terminal Here",
        "icon": "$(terminal)"
      },
      {
        "command": "lighthouse.pickBase",
        "title": "Lighthouse: Pick Base Branch",
        "icon": "$(edit)"
      },
      {
        "command": "lighthouse.pickCompare",
        "title": "Lighthouse: Pick Compare Branch",
        "icon": "$(edit)"
      },
      {
        "command": "lighthouse.swapBranches",
        "title": "Lighthouse: Swap Base/Compare",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "lighthouse.refreshAll",
        "title": "Lighthouse: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "lighthouse.refreshFiles",
        "title": "Lighthouse: Refresh Changed Files",
        "icon": "$(refresh)"
      },
      {
        "command": "lighthouse.refreshThreads",
        "title": "Lighthouse: Refresh Threads",
        "icon": "$(refresh)"
      },
      {
        "command": "lighthouse.openFileDiff",
        "title": "Lighthouse: Open File Diff"
      },
      {
        "command": "lighthouse.openCumulativeFileDiff",
        "title": "Lighthouse: Open Cumulative File Diff"
      },
      {
        "command": "lighthouse.copyCommitSha",
        "title": "Lighthouse: Copy Commit SHA",
        "icon": "$(copy)"
      },
      {
        "command": "lighthouse.updateStaleBranch",
        "title": "Lighthouse: Update Stale Branch (Fast-Forward)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "lighthouse.filesExpandAll",
        "title": "Lighthouse: Expand All Files",
        "icon": "$(expand-all)"
      },
      {
        "command": "lighthouse.filesHideUncommitted",
        "title": "Lighthouse: Hide Uncommitted Changes",
        "icon": "$(eye)"
      },
      {
        "command": "lighthouse.filesShowUncommitted",
        "title": "Lighthouse: Show Uncommitted Changes",
        "icon": "$(eye-closed)"
      },
      {
        "command": "lighthouse.conversationsHideResolved",
        "title": "Lighthouse: Hide Resolved Threads",
        "icon": "$(eye)"
      },
      {
        "command": "lighthouse.conversationsShowResolved",
        "title": "Lighthouse: Show Resolved Threads",
        "icon": "$(eye-closed)"
      },
      {
        "command": "lighthouse.openCommitDiff",
        "title": "Lighthouse: Open Commit Diff"
      },
      {
        "command": "lighthouse.setCommitAsBase",
        "title": "Set as Base",
        "category": "Lighthouse",
        "icon": "$(git-compare)"
      },
      {
        "command": "lighthouse.unpinBase",
        "title": "Lighthouse: Unpin Base (Return to Automatic Selection)",
        "icon": "$(discard)"
      },
      {
        "command": "lighthouse.commitsViewAllChanges",
        "title": "Lighthouse: View All Changes vs Base",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "lighthouse.collapseAllCommits",
        "title": "Lighthouse: Collapse All Commits",
        "icon": "$(collapse-all)"
      },
      {
        "command": "lighthouse.openCommitFileDiff",
        "title": "Lighthouse: Open Commit File Diff"
      },
      {
        "command": "lighthouse.openTerminal",
        "title": "Lighthouse: Open Terminal in Compare Branch Directory",
        "icon": "$(terminal)"
      },
      {
        "command": "lighthouse.copyCompareBranch",
        "title": "Lighthouse: Copy Compare Branch Name",
        "icon": "$(copy)"
      },
      {
        "command": "lighthouse.copyComparePath",
        "title": "Lighthouse: Copy Compare Branch Path",
        "icon": "$(files)"
      }
    ],
    "configuration": {
      "title": "Lighthouse",
      "properties": {
        "lighthouse.tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "idea",
            "question",
            "bug",
            "change",
            "todo",
            "nit",
            "praise"
          ],
          "description": "Tags offered by /tag autocomplete in the comment box and applied to a thread's tags[]."
        },
        "lighthouse.copilotPath": {
          "type": "string",
          "default": "copilot",
          "description": "Path to the Copilot CLI executable used by the 'Ask Copilot to Review' commands."
        },
        "lighthouse.copilotArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-p"
          ],
          "description": "Arguments passed to the Copilot CLI before the generated prompt string (the prompt is appended as the final argument)."
        },
        "lighthouse.defaultRemote": {
          "type": "string",
          "default": "",
          "description": "Default remote name used by 'Git Push'. Leave empty to let git use the branch's configured upstream."
        },
        "lighthouse.autoCreateOnEmpty": {
          "type": "boolean",
          "default": true,
          "description": "When true, activation computes a default base/compare comparison and populates the panel. When false, base/compare stay unset until you pick them and the views show their welcome content."
        },
        "lighthouse.perfLogging": {
          "type": "boolean",
          "default": true,
          "description": "Record correlated startup, Git, storage and pane-readiness timings in the Lighthouse OUTPUT channel and a bounded in-memory trace. Use 'Lighthouse: Export Startup Diagnostics' to save a JSON report. Enable before reloading for a complete startup capture."
        },
        "lighthouse.usageLogging": {
          "type": "boolean",
          "default": true,
          "description": "Automatically record local feature actions, pane exposure and editor-context usage in the Lighthouse output log. No filenames, code, comments or remote telemetry are collected. Independent of performance logging."
        },
        "lighthouse.deferThreadsOnLoad": {
          "type": "boolean",
          "default": true,
          "description": "When true, comment threads are not materialized eagerly during activation; rendering is deferred until an editor becomes visible (or a short fallback delay), avoiding thread flashing and editor-tab churn on load. User actions (reply, resolve) always render immediately."
        },
        "lighthouse.files.compactFolders": {
          "type": "boolean",
          "default": true,
          "description": "When true, single-child folder chains in the Changed Files pane are compacted onto one row (e.g. 'Service/StoreService.Runner/Commands'), mirroring VS Code's explorer.compactFolders. Changes apply immediately — no reload needed."
        },
        "lighthouse.files.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "When true, the Changed Files pane highlights the row matching the active editor, expanding its folders and scrolling it into view, mirroring VS Code's explorer.autoReveal. Revealing never opens or closes an editor."
        },
        "lighthouse.files.cumulativeDiff": {
          "type": "boolean",
          "default": true,
          "description": "When true, the Changed Files pane shows all committed AND uncommitted changes versus the effective baseline (automatic shared ancestor or pinned commit), as a single diff per file. Turn off to view committed and uncommitted changes separately. Only applies when the compare branch is the checked-out branch. Changes apply immediately — no reload needed."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "lighthouse.configureCopilotMcp",
          "when": "view == lighthouse.comparison",
          "group": "1_configuration@0"
        },
        {
          "command": "lighthouse.newConversation",
          "when": "view == lighthouse.conversations",
          "group": "navigation@-1"
        },
        {
          "command": "lighthouse.collapseAllCommits",
          "when": "view == lighthouse.comparison",
          "group": "navigation@0"
        },
        {
          "command": "lighthouse.copyCompareBranch",
          "when": "view == lighthouse.comparison",
          "group": "navigation@1"
        },
        {
          "command": "lighthouse.copyComparePath",
          "when": "view == lighthouse.comparison",
          "group": "navigation@2"
        },
        {
          "command": "lighthouse.openTerminal",
          "when": "view == lighthouse.comparison",
          "group": "navigation@3"
        },
        {
          "command": "lighthouse.refreshAll",
          "when": "view == lighthouse.comparison",
          "group": "navigation@4"
        },
        {
          "command": "lighthouse.filesHideUncommitted",
          "when": "view == lighthouse.files && !lighthouse.filesUncommittedHidden",
          "group": "navigation@0"
        },
        {
          "command": "lighthouse.filesShowUncommitted",
          "when": "view == lighthouse.files && lighthouse.filesUncommittedHidden",
          "group": "navigation@0"
        },
        {
          "command": "lighthouse.filesExpandAll",
          "when": "view == lighthouse.files",
          "group": "navigation@2"
        },
        {
          "command": "lighthouse.refreshFiles",
          "when": "view == lighthouse.files",
          "group": "navigation@3"
        },
        {
          "command": "lighthouse.conversationsHideResolved",
          "when": "view == lighthouse.conversations && !lighthouse.conversationsResolvedHidden",
          "group": "navigation@0"
        },
        {
          "command": "lighthouse.conversationsShowResolved",
          "when": "view == lighthouse.conversations && lighthouse.conversationsResolvedHidden",
          "group": "navigation@0"
        },
        {
          "command": "lighthouse.refreshThreads",
          "when": "view == lighthouse.conversations",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "lighthouse.setCommitAsBase",
          "when": "webviewId == lighthouse.comparison && webviewSection == commit",
          "group": "lighthouse@1"
        },
        {
          "command": "lighthouse.copyCommitSha",
          "when": "webviewId == lighthouse.comparison && webviewSection == commit",
          "group": "lighthouse@2"
        },
        {
          "command": "lighthouse.openCommitDiff",
          "when": "webviewId == lighthouse.comparison && webviewSection == commit",
          "group": "lighthouse@3"
        }
      ],
      "view/item/context": [
        {
          "command": "lighthouse.resolveThreadNode",
          "when": "view == lighthouse.conversations && viewItem == lighthouse.thread.unresolved",
          "group": "inline@1"
        },
        {
          "command": "lighthouse.unresolveThreadNode",
          "when": "view == lighthouse.conversations && viewItem == lighthouse.thread.resolved",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "lighthouse.toggleThreadResolved",
          "group": "inline@1",
          "when": "commentController == lighthouse"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "lighthouse.createOrReply",
          "group": "inline@1",
          "when": "commentController == lighthouse"
        }
      ],
      "commandPalette": [
        {
          "command": "lighthouse.refreshFiles",
          "when": "false"
        },
        {
          "command": "lighthouse.refreshThreads",
          "when": "false"
        },
        {
          "command": "lighthouse.viewConversation",
          "when": "false"
        },
        {
          "command": "lighthouse.setCommitAsBase",
          "when": "false"
        },
        {
          "command": "lighthouse.createOrReply",
          "when": "false"
        },
        {
          "command": "lighthouse.resolveThread",
          "when": "false"
        },
        {
          "command": "lighthouse.unresolveThread",
          "when": "false"
        },
        {
          "command": "lighthouse.resolveThreadNode",
          "when": "false"
        },
        {
          "command": "lighthouse.unresolveThreadNode",
          "when": "false"
        },
        {
          "command": "lighthouse.askCopilotThread",
          "when": "false"
        },
        {
          "command": "lighthouse.openFileDiff",
          "when": "false"
        },
        {
          "command": "lighthouse.openCumulativeFileDiff",
          "when": "false"
        },
        {
          "command": "lighthouse.openCommitDiff",
          "when": "false"
        },
        {
          "command": "lighthouse.openCommitFileDiff",
          "when": "false"
        },
        {
          "command": "lighthouse.copyCommitSha",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "version:prepare": "node scripts/build-version.cjs prepare",
    "version:check": "node scripts/build-version.cjs check",
    "vscode:prepublish": "npm run version:check && npm run compile",
    "compile": "tsc -p ./ && tsc -p tsconfig.mcp.json && node scripts/build-mcp.cjs",
    "test": "npm run compile && node --test",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.11.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "0.28.2",
    "typescript": "^5.4.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "markdown-it": "^14.3.1",
    "proper-lockfile": "^4.1.2"
  }
}
